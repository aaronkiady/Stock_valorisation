/**
 * Composant Mouvements - Gestion des entrées et sorties avec validation
 * ✅ CORRECTION : Filtre par type de mouvement fonctionnel
 */
import React, { useState, useEffect } from 'react';
import { Mouvement, Stock, Chantier } from '../types';
import { mouvementsApi, stocksApi, chantiersApi } from '../services/api';
import { Plus, Search, Trash2, Calendar, AlertCircle, AlertTriangle } from 'lucide-react';
import SearchableSelect from './SearchableSelect';

const Mouvements: React.FC = () => {
  const [mouvements, setMouvements] = useState<Mouvement[]>([]);
  const [stocks, setStocks] = useState<Stock[]>([]);
  const [chantiers, setChantiers] = useState<Chantier[]>([]);
  const [loading, setLoading] = useState(true);
  const [showModal, setShowModal] = useState(false);
  const [currentPage, setCurrentPage] = useState(1);
  const [totalPages, setTotalPages] = useState(1);
  const [filters, setFilters] = useState({
    chantier_id: undefined as number | undefined,
    date_debut: '',
    date_fin: '',
    type_mouvement: '' as '' | 'ENTREE' | 'SORTIE'
  });
  const [formData, setFormData] = useState({
    date: new Date().toISOString().split('T')[0],
    numero_bs_br_cj: '',
    chantier_id: undefined as number | undefined,
    stock_id: undefined as number | undefined,
    entree: 0,
    sortie: 0,
    commentaire: ''
  });
  const [error, setError] = useState<string | null>(null);
  const [success, setSuccess] = useState<string | null>(null);
  const [stockWarning, setStockWarning] = useState<string | null>(null);
  const [stockError, setStockError] = useState<string | null>(null);

  useEffect(() => {
    loadMouvements();
    loadStocks();
    loadChantiers();
  }, [currentPage, filters]);

  // Vérifier le stock disponible quand on change le stock sélectionné ou la quantité de sortie
  useEffect(() => {
    validateStock();
  }, [formData.stock_id, formData.sortie]);

  const loadMouvements = async () => {
    try {
      setLoading(true);
      
      // ✅ CORRECTION: Construction correcte des paramètres avec type_mouvement
      const params: any = {
        page: currentPage,
        per_page: 20
      };

      // Ajouter les filtres seulement s'ils sont définis
      if (filters.chantier_id) {
        params.chantier_id = filters.chantier_id;
      }
      if (filters.date_debut) {
        params.date_debut = filters.date_debut;
      }
      if (filters.date_fin) {
        params.date_fin = filters.date_fin;
      }
      if (filters.type_mouvement) {
        params.type_mouvement = filters.type_mouvement; // ✅ CORRECTION: type_mouvement
      }

      console.log('📤 Paramètres envoyés:', params); // Debug

      const response = await mouvementsApi.getAll(params);
      setMouvements(response.mouvements || []);
      setTotalPages(response.pages || 1);
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Erreur de chargement');
    } finally {
      setLoading(false);
    }
  };

  const loadStocks = async () => {
    try {
      const data = await stocksApi.getAll();
      setStocks(data.stocks || data.items || []);
    } catch (err) {
      console.error('Erreur chargement stocks:', err);
    }
  };

  const loadChantiers = async () => {
    try {
      const data = await chantiersApi.getAll();
      if (data && data.chantiers) {
        setChantiers(data.chantiers);
      } else if (Array.isArray(data)) {
        setChantiers(data);
      } else {
        console.error('Format de réponse invalide pour chantiers:', data);
        setChantiers([]);
      }
    } catch (err) {
      console.error('Erreur chargement chantiers:', err);
      setChantiers([]);
    }
  };

  // Validation du stock disponible
  const validateStock = () => {
    setStockWarning(null);
    setStockError(null);
    setError(null);

    if (formData.sortie > 0 && formData.stock_id) {
      const selectedStock = stocks.find(s => s.id === formData.stock_id);
      
      if (selectedStock) {
        const stockDisponible = selectedStock.quantite_finale;
        
        // ERREUR CRITIQUE : Stock insuffisant - BLOQUE la soumission
        if (formData.sortie > stockDisponible) {
          setStockError(
            `❌ ERREUR CRITIQUE : Stock insuffisant !\n` +
            `Disponible : ${stockDisponible.toFixed(2)} ${selectedStock.unite || ''}\n` +
            `Demandé : ${formData.sortie.toFixed(2)} ${selectedStock.unite || ''}`
          );
        } 
        // AVERTISSEMENT : Plus de 80% du stock - N'empêche PAS la soumission
        else if (formData.sortie > stockDisponible * 0.8) {
          setStockWarning(
            `⚠️ Attention : Cette sortie représente ${((formData.sortie / stockDisponible) * 100).toFixed(0)}% du stock disponible. ` +
            `Assurez-vous que c'est intentionnel.`
          );
        }
      }
    }
  };

  // Préparer les options pour SearchableSelect - STOCKS
  const stockOptions = stocks.map(stock => ({
    value: stock.id,
    label: stock.numero_fiche.toString(),
    sublabel: `${stock.article?.nom} - Dispo: ${stock.quantite_finale.toFixed(2)} ${stock.unite || ''}`
  }));

  // Préparer les options pour SearchableSelect - CHANTIERS
  const chantierOptions = chantiers
    .filter(c => c.statut === 'Actif')
    .map(chantier => ({
      value: chantier.id,
      label: chantier.code,
      sublabel: chantier.nom
    }));

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError(null);
    setSuccess(null);

    // Validation de base
    if (!formData.stock_id) {
      setError('Veuillez sélectionner un stock');
      return;
    }

    if (formData.entree === 0 && formData.sortie === 0) {
      setError('Veuillez saisir une entrée ou une sortie');
      return;
    }

    if (formData.entree > 0 && formData.sortie > 0) {
      setError('Une entrée OU une sortie, pas les deux');
      return;
    }

    // Validation critique du stock pour les sorties
    if (formData.sortie > 0) {
      const selectedStock = stocks.find(s => s.id === formData.stock_id);
      
      if (!selectedStock) {
        setError('Stock non trouvé');
        return;
      }

      const stockDisponible = selectedStock.quantite_finale;
      
      // UNIQUEMENT bloquer si stock réellement insuffisant
      if (formData.sortie > stockDisponible) {
        setError(
          `❌ ERREUR : Stock insuffisant !\n\n` +
          `Stock disponible : ${stockDisponible.toFixed(2)} ${selectedStock.unite || ''}\n` +
          `Quantité demandée : ${formData.sortie.toFixed(2)} ${selectedStock.unite || ''}\n` +
          `Manque : ${(formData.sortie - stockDisponible).toFixed(2)} ${selectedStock.unite || ''}\n\n` +
          `Veuillez ajuster la quantité de sortie.`
        );
        return;
      }
    }

    try {
      const dataToSubmit = {
        date: formData.date,
        numero_bs_br_cj: formData.numero_bs_br_cj,
        chantier_id: formData.chantier_id,
        stock_id: formData.stock_id!,
        article_id: stocks.find(s => s.id === formData.stock_id)?.article_id!,
        entree: formData.entree || undefined,
        sortie: formData.sortie || undefined,
        commentaire: formData.commentaire
      };

      await mouvementsApi.create(dataToSubmit);
      setSuccess('Mouvement enregistré avec succès');
      
      // Recharger les données
      loadMouvements();
      loadStocks();
      
      resetForm();
      setShowModal(false);

      setTimeout(() => setSuccess(null), 3000);
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Erreur lors de l\'enregistrement');
    }
  };

  const handleDelete = async (id: number) => {
    if (!window.confirm('Êtes-vous sûr de vouloir supprimer ce mouvement ?')) return;

    try {
      await mouvementsApi.delete(id);
      setSuccess('Mouvement supprimé avec succès');
      loadMouvements();
      loadStocks();
      setTimeout(() => setSuccess(null), 3000);
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Erreur lors de la suppression');
    }
  };

  const resetForm = () => {
    setFormData({
      date: new Date().toISOString().split('T')[0],
      numero_bs_br_cj: '',
      chantier_id: undefined,
      stock_id: undefined,
      entree: 0,
      sortie: 0,
      commentaire: ''
    });
    setError(null);
    setStockWarning(null);
  };

  const clearFilters = () => {
    setFilters({
      chantier_id: undefined,
      date_debut: '',
      date_fin: '',
      type_mouvement: ''
    });
    setCurrentPage(1);
  };

  if (loading) {
    return (
      <div className="flex items-center justify-center h-64">
        <div className="text-xl text-gray-600">Chargement...</div>
      </div>
    );
  }

  return (
    <div className="p-6">
      {/* En-tête */}
      <div className="mb-6">
        <h1 className="text-3xl font-bold text-gray-900 mb-2">Mouvements de Stock</h1>
        <p className="text-gray-600">Gérer les entrées et sorties de stock</p>
      </div>

      {/* Messages */}
      {error && (
        <div className="mb-4 p-4 bg-red-50 border border-red-200 text-red-700 rounded-lg flex items-start">
          <AlertCircle className="mr-2 mt-0.5 flex-shrink-0" size={20} />
          <div className="whitespace-pre-line">{error}</div>
        </div>
      )}
      
      {success && (
        <div className="mb-4 p-4 bg-green-50 border border-green-200 text-green-700 rounded-lg">
          ✓ {success}
        </div>
      )}

      {/* Filtres */}
      <div className="bg-white rounded-lg shadow p-4 mb-6">
        <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">Type</label>
            <select
              value={filters.type_mouvement}
              onChange={(e) => setFilters({ ...filters, type_mouvement: e.target.value as any })}
              className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <option value="">Tous</option>
              <option value="ENTREE">Entrées</option>
              <option value="SORTIE">Sorties</option>
            </select>
          </div>

          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">Chantier</label>
            <select
              value={filters.chantier_id || ''}
              onChange={(e) => setFilters({ 
                ...filters, 
                chantier_id: e.target.value ? parseInt(e.target.value) : undefined 
              })}
              className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <option value="">Tous les chantiers</option>
              {chantiers.map(c => (
                <option key={c.id} value={c.id}>{c.code} - {c.nom}</option>
              ))}
            </select>
          </div>

          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">Date début</label>
            <input
              type="date"
              value={filters.date_debut}
              onChange={(e) => setFilters({ ...filters, date_debut: e.target.value })}
              className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>

          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">Date fin</label>
            <input
              type="date"
              value={filters.date_fin}
              onChange={(e) => setFilters({ ...filters, date_fin: e.target.value })}
              className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>
        </div>

        <div className="mt-4 flex justify-between">
          <button
            onClick={clearFilters}
            className="px-4 py-2 text-sm text-gray-600 hover:text-gray-900"
          >
            Réinitialiser les filtres
          </button>
          
          <button
            onClick={() => {
              resetForm();
              setShowModal(true);
            }}
            className="flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
          >
            <Plus size={20} className="mr-2" />
            Nouveau Mouvement
          </button>
        </div>
      </div>

      {/* Tableau des mouvements */}
      <div className="bg-white rounded-lg shadow overflow-hidden">
        <div className="overflow-x-auto">
          <table className="min-w-full divide-y divide-gray-200">
            <thead className="bg-gray-50">
              <tr>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">N° BS/BR</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Chantier</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">N° Fiche</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Article</th>
                <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Entrée</th>
                <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Sortie</th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Commentaire</th>
                <th className="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Actions</th>
              </tr>
            </thead>
            <tbody className="bg-white divide-y divide-gray-200">
              {mouvements.length === 0 ? (
                <tr>
                  <td colSpan={9} className="px-6 py-12 text-center text-gray-500">
                    Aucun mouvement enregistré
                  </td>
                </tr>
              ) : (
                mouvements.map((mouvement) => (
                  <tr key={mouvement.id} className="hover:bg-gray-50">
                    <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                      {new Date(mouvement.date).toLocaleDateString('fr-FR')}
                    </td>
                    <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                      {mouvement.numero_bs_br_cj || '-'}
                    </td>
                    <td className="px-6 py-4 text-sm text-gray-900">
                      {mouvement.chantier ? (
                        <div>
                          <div className="font-medium">{mouvement.chantier.code}</div>
                          <div className="text-xs text-gray-500">{mouvement.chantier.nom}</div>
                        </div>
                      ) : '-'}
                    </td>
                    <td className="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                      {mouvement.stock_numero || '-'}
                    </td>
                    <td className="px-6 py-4 text-sm text-gray-900">
                      <div className="font-medium">{mouvement.article?.nom}</div>
                      <div className="text-xs text-gray-500">{mouvement.article?.reference_interne}</div>
                    </td>
                    <td className="px-6 py-4 whitespace-nowrap text-sm text-right text-green-600 font-medium">
                      {mouvement.entree && mouvement.entree > 0 ? `+${mouvement.entree.toFixed(2)}` : '-'}
                    </td>
                    <td className="px-6 py-4 whitespace-nowrap text-sm text-right text-red-600 font-medium">
                      {mouvement.sortie && mouvement.sortie > 0 ? `-${mouvement.sortie.toFixed(2)}` : '-'}
                    </td>
                    <td className="px-6 py-4 text-sm text-gray-600 max-w-xs truncate">
                      {mouvement.commentaire || '-'}
                    </td>
                    <td className="px-6 py-4 whitespace-nowrap text-center text-sm">
                      <button
                        onClick={() => handleDelete(mouvement.id)}
                        className="text-red-600 hover:text-red-900"
                        title="Supprimer"
                      >
                        <Trash2 size={18} />
                      </button>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>

        {/* Pagination */}
        {totalPages > 1 && (
          <div className="px-6 py-4 border-t border-gray-200 flex items-center justify-between">
            <div className="text-sm text-gray-600">
              Page {currentPage} sur {totalPages}
            </div>
            <div className="flex space-x-2">
              <button
                onClick={() => setCurrentPage(Math.max(1, currentPage - 1))}
                disabled={currentPage === 1}
                className="px-3 py-1 border rounded disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-50"
              >
                Précédent
              </button>
              <button
                onClick={() => setCurrentPage(Math.min(totalPages, currentPage + 1))}
                disabled={currentPage === totalPages}
                className="px-3 py-1 border rounded disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-50"
              >
                Suivant
              </button>
            </div>
          </div>
        )}
      </div>

      {/* Modal de création */}
      {showModal && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
          <div className="bg-white rounded-lg p-6 w-full max-w-3xl max-h-[90vh] overflow-y-auto">
            <h2 className="text-2xl font-bold mb-6">Nouveau Mouvement</h2>

            {stockError && (
              <div className="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 rounded flex items-start">
                <AlertCircle className="mr-2 mt-0.5 flex-shrink-0" size={18} />
                <div className="whitespace-pre-line text-sm">{stockError}</div>
              </div>
            )}

            {stockWarning && !stockError && (
              <div className="mb-4 p-3 bg-yellow-50 border border-yellow-200 text-yellow-800 rounded flex items-start">
                <AlertTriangle className="mr-2 mt-0.5 flex-shrink-0" size={18} />
                <div className="text-sm">{stockWarning}</div>
              </div>
            )}

            <form onSubmit={handleSubmit} className="space-y-4">
              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">
                    Date <span className="text-red-500">*</span>
                  </label>
                  <input
                    type="date"
                    required
                    value={formData.date}
                    onChange={(e) => setFormData({ ...formData, date: e.target.value })}
                    className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">
                    N° BS/BR
                  </label>
                  <input
                    type="text"
                    value={formData.numero_bs_br_cj}
                    onChange={(e) => setFormData({ ...formData, numero_bs_br_cj: e.target.value })}
                    className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                  />
                </div>
              </div>

              <SearchableSelect
                label="N° Fiche de Stock *"
                options={stockOptions}
                value={formData.stock_id}
                onChange={(value) => setFormData({ ...formData, stock_id: value as number | undefined })}
                placeholder="Rechercher un stock par N° Fiche..."
                allowEmpty={false}
                error={error && !formData.stock_id ? 'Stock requis' : undefined}
              />

              <SearchableSelect
                label="Chantier"
                options={chantierOptions}
                value={formData.chantier_id}
                onChange={(value) => setFormData({ ...formData, chantier_id: value as number | undefined })}
                placeholder="Rechercher un chantier..."
                allowEmpty={true}
              />

              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">
                    Entrée (quantité)
                  </label>
                  <input
                    type="number"
                    step="0.01"
                    min="0"
                    value={formData.entree}
                    onChange={(e) => setFormData({
                      ...formData,
                      entree: parseFloat(e.target.value) || 0,
                      sortie: 0
                    })}
                    className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">
                    Sortie (quantité)
                  </label>
                  <input
                    type="number"
                    step="0.01"
                    min="0"
                    value={formData.sortie}
                    onChange={(e) => setFormData({
                      ...formData,
                      sortie: parseFloat(e.target.value) || 0,
                      entree: 0
                    })}
                    className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                  />
                </div>
              </div>

              {/* Afficher les infos du stock sélectionné */}
              {formData.stock_id && (
                <div className="p-3 bg-blue-50 border border-blue-200 rounded-lg">
                  <div className="text-sm">
                    <strong>Stock sélectionné :</strong>
                    {(() => {
                      const stock = stocks.find(s => s.id === formData.stock_id);
                      return stock ? (
                        <div className="mt-1">
                          <div>Article : {stock.article?.nom}</div>
                          <div className="font-semibold text-blue-900">
                            Quantité disponible : {stock.quantite_finale.toFixed(2)} {stock.unite || ''}
                          </div>
                        </div>
                      ) : null;
                    })()}
                  </div>
                </div>
              )}

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">
                  Commentaire
                </label>
                <textarea
                  value={formData.commentaire}
                  onChange={(e) => setFormData({ ...formData, commentaire: e.target.value })}
                  rows={3}
                  className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>

              <div className="flex justify-end space-x-3 pt-4 border-t">
                <button
                  type="button"
                  onClick={() => {
                    setShowModal(false);
                    resetForm();
                  }}
                  className="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors"
                >
                  Annuler
                </button>
                <button
                  type="submit"
                  disabled={!!stockError}
                  className="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  Enregistrer
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
};

export default Mouvements;