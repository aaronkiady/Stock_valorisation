/**
 * Service API pour communiquer avec le backend Flask
 * Version COMPLÈTE CORRIGÉE avec gestion améliorée des erreurs
 */
import {
  Article,
  Chantier,
  Stock,
  Mouvement,
  AuditLog,
  DashboardStats,
  StockParChantier,
  PaginatedResponse,
  ArticleFormData,
  StockFormData,
  MouvementFormData,
  ChantierFormData,
  SearchFilters
} from '../types';

const API_BASE_URL = process.env.REACT_APP_API_URL || 'http://localhost:5880/api';

// Helper pour les headers avec authentification
const getHeaders = (): HeadersInit => {
  const token = localStorage.getItem('token');
  return {
    'Content-Type': 'application/json',
    ...(token && { 'Authorization': `Bearer ${token}` })
  };
};

// ✅ FONCTION AMÉLIORÉE: Fetch avec timeout et gestion d'erreurs complète
const fetchWithTimeout = async (url: string, options: RequestInit = {}, timeout = 10000): Promise<Response> => {
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), timeout);

  try {
    const response = await fetch(url, {
      ...options,
      signal: controller.signal,
      credentials: 'include' // Important pour les cookies CORS
    });
    clearTimeout(timeoutId);
    return response;
  } catch (error) {
    clearTimeout(timeoutId);
    if (error instanceof DOMException && error.name === 'AbortError') {
      throw new Error(`Timeout: Le serveur n'a pas répondu dans les ${timeout}ms`);
    }
    if (error instanceof TypeError && error.message.includes('Failed to fetch')) {
      throw new Error('Impossible de contacter le serveur. Vérifiez:\n1. Que le backend est démarré\n2. Les extensions navigateur (AdBlock)\n3. La connexion réseau');
    }
    throw error;
  }
};

// ✅ HELPER AMÉLIORÉ: Gestion des réponses avec messages d'erreur détaillés
const handleResponse = async <T>(response: Response): Promise<T> => {
  if (!response.ok) {
    let errorData;
    try {
      errorData = await response.json();
    } catch {
      errorData = { error: `Erreur HTTP ${response.status}: ${response.statusText}` };
    }
    
    // Messages d'erreur spécifiques selon le code HTTP
    switch (response.status) {
      case 400:
        throw new Error(errorData.error || 'Requête invalide');
      case 401:
        // Auto-logout si token invalide
        if (localStorage.getItem('token')) {
          localStorage.removeItem('token');
          localStorage.removeItem('user');
          window.dispatchEvent(new Event('storage'));
        }
        throw new Error(errorData.error || 'Session expirée - Veuillez vous reconnecter');
      case 403:
        throw new Error(errorData.error || 'Accès refusé - Droits insuffisants');
      case 404:
        throw new Error(errorData.error || 'Ressource non trouvée');
      case 409:
        throw new Error(errorData.error || 'Conflit - La ressource existe déjà');
      case 422:
        throw new Error(errorData.error || 'Données invalides');
      case 500:
        throw new Error(errorData.error || 'Erreur serveur interne - Contactez l\'administrateur');
      case 502:
        throw new Error('Serveur indisponible - Veuillez réessayer plus tard');
      case 503:
        throw new Error('Service temporairement indisponible');
      default:
        throw new Error(errorData.error || `Erreur ${response.status}: ${response.statusText}`);
    }
  }
  
  try {
    return await response.json();
  } catch (error) {
    throw new Error('Erreur de parsing de la réponse serveur');
  }
};

// ==================== AUTHENTIFICATION ====================

export interface UserData {
  id: number;
  username: string;
  email: string;
  full_name: string;
  role: 'admin' | 'user';
  created_at?: string;
}

export interface UserFormData {
  username: string;
  email: string;
  full_name: string;
  password: string;
  role: 'admin' | 'user';
}

export const authApi = {
  login: async (username: string, password: string): Promise<{ token: string; user: UserData }> => {
    const response = await fetchWithTimeout(`${API_BASE_URL}/auth/login`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ username, password })
    }, 15000); // 15s timeout pour le login
    
    return handleResponse<{ token: string; user: UserData }>(response);
  },

  verifyToken: async (): Promise<{ valid: boolean; user: UserData }> => {
    const response = await fetchWithTimeout(`${API_BASE_URL}/auth/verify`, {
      headers: getHeaders()
    });
    return handleResponse<{ valid: boolean; user: UserData }>(response);
  },

  logout: async (): Promise<{ message: string }> => {
    const response = await fetchWithTimeout(`${API_BASE_URL}/auth/logout`, {
      method: 'POST',
      headers: getHeaders()
    });
    return handleResponse<{ message: string }>(response);
  }
};

// ==================== ARTICLES ====================

export const articlesApi = {
  getAll: async (filters: SearchFilters = {}): Promise<PaginatedResponse<Article>> => {
    const params = new URLSearchParams();
    if (filters.search) params.append('search', filters.search);
    if (filters.page) params.append('page', filters.page.toString());
    if (filters.per_page) params.append('per_page', filters.per_page.toString());

    const response = await fetchWithTimeout(`${API_BASE_URL}/articles?${params}`, {
      headers: getHeaders()
    });
    return handleResponse<PaginatedResponse<Article>>(response);
  },

  getById: async (id: number): Promise<Article> => {
    const response = await fetchWithTimeout(`${API_BASE_URL}/articles/${id}`, {
      headers: getHeaders()
    });
    return handleResponse<Article>(response);
  },

  create: async (data: ArticleFormData): Promise<Article> => {
    const response = await fetchWithTimeout(`${API_BASE_URL}/articles`, {
      method: 'POST',
      headers: getHeaders(),
      body: JSON.stringify(data)
    });
    return handleResponse<Article>(response);
  },

  update: async (id: number, data: Partial<ArticleFormData>): Promise<Article> => {
    const response = await fetchWithTimeout(`${API_BASE_URL}/articles/${id}`, {
      method: 'PUT',
      headers: getHeaders(),
      body: JSON.stringify(data)
    });
    return handleResponse<Article>(response);
  },

  delete: async (id: number): Promise<{ message: string }> => {
    const response = await fetchWithTimeout(`${API_BASE_URL}/articles/${id}`, {
      method: 'DELETE',
      headers: getHeaders()
    });
    return handleResponse<{ message: string }>(response);
  }
};

