// ✅ FONCTION DE TEST DE CONNEXION
export const testConnection = async (): Promise<{ status: string; database: string }> => {
  try {
    const response = await fetchWithTimeout(`${API_BASE_URL}/health`, {}, 5000);
    return await response.json();
  } catch (error) {
    throw new Error(`Impossible de contacter le serveur: ${error instanceof Error ? error.message : 'Erreur inconnue'}`);
  }
};

// ✅ FONCTION POUR LISTER TOUTES LES ROUTES (DEBUG)
export const listRoutes = async (): Promise<any[]> => {
  const response = await fetchWithTimeout(`${API_BASE_URL}/routes`, {
    headers: getHeaders()
  });
  return handleResponse<any[]>(response);
};